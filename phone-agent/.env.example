# Copy to .env, fill in, then:  set -a; source .env; set +a
# NEVER commit the real .env.

# Claude (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (https://console.twilio.com -> Account info)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567   # a Twilio number you bought (E.164 format)

# Your phone, the one the agent calls (E.164, e.g. +14155550123).
# On a Twilio trial account this number must be a "Verified Caller ID".
MY_PHONE_NUMBER=+1...

# Only for `talk` mode: the public HTTPS URL that forwards to this machine's PORT,
# e.g. from `ngrok http 5050` or `cloudflared tunnel --url http://localhost:5050`
PUBLIC_URL=https://xxxx.ngrok-free.app
PORT=5050

# Optional tuning
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=low          # low = fastest replies on the phone
# TWILIO_VOICE=Polly.Joanna-Neural
# MAX_TURNS=20
